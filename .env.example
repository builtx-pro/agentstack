# Generate real credentials with tools/setup/init-env.mjs; never commit .env.
APP_ORIGIN=http://localhost:4311
HOST_PORT=4311
HOST_BIND=127.0.0.1
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
ADMIN_EMAIL=
ADMIN_NAME=Workspace owner

# Explicit proxy IP/CIDR only; empty means forwarded headers are untrusted.
TRUST_PROXY=
