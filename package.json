{
  "name": "agentstack",
  "version": "0.4.0",
  "private": true,
  "description": "A shared workspace for humans and coding agents",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @agentstack/server",
    "dev:web": "npm run dev --workspace @agentstack/web",
    "build": "npm run build --workspace @agentstack/sdk && npm run build --workspace @agentstack/cli && npm run build --workspace @agentstack/mcp && npm run build --workspace @agentstack/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "migrate": "npm run migrate --workspace @agentstack/server",
    "bootstrap": "npm run bootstrap --workspace @agentstack/server",
    "start": "npm run start --workspace @agentstack/server",
    "test:migration": "python3 -m unittest discover -s tools/migration -p \"test_*.py\"",
    "test:setup": "node --test tools/setup/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "vitest": "5.1.0",
    "@types/node": "^26.6.6"
  },
  "license": "Apache-2.0"
}
